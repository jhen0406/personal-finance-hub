# 複製成 .env.local 後填值。.env.local 不進版本控制。

# 開發用資料庫（docker compose 啟動的本機 Postgres）
DATABASE_URL=postgres://pfh:pfh@localhost:54329/pfh

# 整合測試用資料庫，測試會清空其中的資料
TEST_DATABASE_URL=postgres://pfh:pfh@localhost:54329/pfh_test

# 選填：migration 用的直連網址（Vercel + Neon 會自動提供）；未設定時使用 DATABASE_URL
# DATABASE_URL_UNPOOLED=
